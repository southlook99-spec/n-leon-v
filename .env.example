# URL PostgreSQL hébergée (Neon, Supabase, Vercel Marketplace…)
# Exemple Neon : postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# PayPal Checkout — paiement PayPal et carte bancaire
# Créez une application REST API dans PayPal Developer > Apps & Credentials.
# Utilisez d'abord les identifiants Sandbox, puis les identifiants Live.
NEXT_PUBLIC_PAYPAL_CLIENT_ID="VOTRE_CLIENT_ID_PAYPAL"
PAYPAL_CLIENT_ID="VOTRE_CLIENT_ID_PAYPAL"
PAYPAL_CLIENT_SECRET="VOTRE_SECRET_PAYPAL"
PAYPAL_ENV="sandbox"
